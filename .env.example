# Copy to .env.local and fill in. NEVER commit .env.local.
# Server-side only — this key is read by Next.js route handlers and
# is never exposed to the browser.
ANTHROPIC_API_KEY=

# Required ONLY for identity-linked API keys: the wrkspc_... id of the
# workspace requests act in (Claude Console -> Settings -> Workspaces).
# Workspace-scoped API keys can leave this unset.
ANTHROPIC_WORKSPACE_ID=

# Kill switch: set to 1 to disable all AI generation in the games
# (they fall back to offline placeholder content).
AI_GAMES_DISABLED=

# PRODUCTION (Vercel): durable rate limits, daily budgets, and AI
# caches. Add "Upstash Redis" from the Vercel Marketplace (free tier)
# and it sets these automatically. Unset = per-instance memory (dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional global daily caps on AI generations (cost ceilings).
# Defaults: derby 150 races/day, pond 1200 fish/day.
BUDGET_DERBY_PER_DAY=
BUDGET_POND_PER_DAY=
